# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file. Placeholders only; never put a real secret here.
# On GCP the same variables come from Cloud Run settings and Secret Manager
# (see docs/labs/lab-05/deployment.md).

# PostgreSQL connection (secret in the cloud). Local value matches docker-compose.yml.
DATABASE_URL="postgresql://cpms:cpms@localhost:5432/cpms?schema=public"

# Port the API listens on. Cloud Run sets it; 3000 locally.
PORT=3000

# Secret used to sign auth tokens. Use a long random value; never commit a real one.
JWT_SECRET="change-me-local-only"
JWT_EXPIRES_IN="2h"

# Password for the synthetic demo accounts created by the seed. Required: the seed
# refuses to run without it. In the cloud it comes from Secret Manager.
SEED_DEMO_PASSWORD="change-me-demo-password"

# Runtime mode. Docker images and Cloud Run use "production".
# NODE_ENV=development

# Folder with the built React app. When set, the API also serves the UI (one container).
# The Docker image sets /app/client/dist; leave unset for `npm run dev`.
# CLIENT_DIST_DIR=../client/dist

# Database for the server tests. Optional: by default the database name in
# DATABASE_URL is replaced with "cpms_test". The name must end with "_test".
# TEST_DATABASE_URL="postgresql://cpms:cpms@localhost:5432/cpms_test?schema=public"
