// Prisma schema for the Course Project Management System.
// Your DATABASE_URL lives in server/.env
//
// Models are added from the approved data model in docs/system-sds.md
// together with a migration, as part of each feature contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
