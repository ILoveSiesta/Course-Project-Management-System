generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String
  role                  Role
  passwordHash          String
  createdAt             DateTime               @default(now())
  memberships           TeamMembership[]
  supervisorAssignments SupervisorAssignment[]
  milestonesCreated     Milestone[]            @relation("MilestoneCreatedBy")
  submissions           Submission[]
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
}

model Team {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  createdAt             DateTime               @default(now())
  memberships           TeamMembership[]
  supervisorAssignments SupervisorAssignment[]
  milestones            Milestone[]
}

model TeamMembership {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  studentId Int      @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

model SupervisorAssignment {
  id           Int      @id @default(autoincrement())
  teamId       Int
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  supervisorId Int
  supervisor   User     @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@unique([teamId, supervisorId])
}

model Milestone {
  id          Int          @id @default(autoincrement())
  teamId      Int
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(2000)
  deadline    DateTime     @db.Timestamptz(3)
  createdById Int
  createdBy   User         @relation("MilestoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  submissions Submission[]

  @@index([teamId, deadline])
}

model Submission {
  id            Int       @id @default(autoincrement())
  milestoneId   Int
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  submittedById Int
  submittedBy   User      @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  version       Int
  title         String    @db.VarChar(120)
  description   String?   @db.VarChar(2000)
  link          String    @db.VarChar(2048)
  submittedAt   DateTime  @default(now()) @db.Timestamptz(3)
  daysLate      Int

  @@unique([milestoneId, version])
  @@index([milestoneId, submittedAt])
}
