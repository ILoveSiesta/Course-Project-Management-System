generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String
  role                  Role
  passwordHash          String
  createdAt             DateTime               @default(now())
  memberships           TeamMembership[]
  supervisorAssignments SupervisorAssignment[]
  milestonesCreated     Milestone[]            @relation("MilestoneCreatedBy")
  submissions           Submission[]
  feedbackGiven         Feedback[]
  gradesGiven           Grade[]
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
}

model Team {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  createdAt             DateTime               @default(now())
  memberships           TeamMembership[]
  supervisorAssignments SupervisorAssignment[]
  milestones            Milestone[]
}

model TeamMembership {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  studentId Int      @unique
  student   User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

model SupervisorAssignment {
  id           Int      @id @default(autoincrement())
  teamId       Int
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  supervisorId Int
  supervisor   User     @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@unique([teamId, supervisorId])
}

model Milestone {
  id               Int          @id @default(autoincrement())
  teamId           Int
  team             Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  title            String       @db.VarChar(120)
  description      String?      @db.VarChar(2000)
  deadline         DateTime     @db.Timestamptz(3)
  createdById      Int
  createdBy        User         @relation("MilestoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  submissions      Submission[]
  // F-08: set once when the milestone's grades are released (BR-11); null = not released.
  gradesReleasedAt DateTime?    @db.Timestamptz(3)
  grade            Grade?

  @@index([teamId, deadline])
}

model Submission {
  id            Int        @id @default(autoincrement())
  milestoneId   Int
  milestone     Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  submittedById Int
  submittedBy   User       @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  version       Int
  title         String     @db.VarChar(120)
  description   String?    @db.VarChar(2000)
  link          String     @db.VarChar(2048)
  submittedAt   DateTime   @default(now()) @db.Timestamptz(3)
  daysLate      Int
  feedback      Feedback[]
  grades        Grade[]

  @@unique([milestoneId, version])
  @@index([milestoneId, submittedAt])
}

model Feedback {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  authorId     Int
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comment      String     @db.VarChar(5000)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([submissionId, createdAt])
}

// F-08: one grade per milestone, linked to the graded submission version of that milestone (BR-11).
model Grade {
  id           Int        @id @default(autoincrement())
  milestoneId  Int        @unique
  milestone    Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  score        Int
  gradedById   Int
  gradedBy     User       @relation(fields: [gradedById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
}
